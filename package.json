{
  "name": "piwi-tui",
  "version": "1.2.2",
  "description": "Pi + Wiki: a playful, safe, full-featured TUI extension pack for pi.dev.",
  "keywords": ["pi-package", "pi.dev", "tui", "coding-agent", "piwi"],
  "author": "JoulesDotDev",
  "license": "MIT",
  "homepage": "https://github.com/JoulesDotDev/piwi-tui#readme",
  "bugs": {
    "url": "https://github.com/JoulesDotDev/piwi-tui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoulesDotDev/piwi-tui.git"
  },
  "files": [
    "extensions/",
    "lib/",
    "prompts/",
    "themes/",
    "scripts/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "scripts": {
    "check": "bun scripts/check.ts",
    "test:tui": "bun scripts/tui-render-test.ts"
  },
  "pi": {
    "extensions": ["./extensions"],
    "prompts": ["./prompts"],
    "themes": ["./themes"]
  },
  "comment": "Pi installs runtime dependencies automatically for npm and Git package sources. Local-path contributors should run npm install or bun install.",
  "dependencies": {
    "@aliou/pi-processes": "^0.9.4",
    "@napi-rs/canvas": "^0.1.69",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.7.3",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "unpdf": "^1.6.2"
  },
  "optionalDependencies": {
    "officeparser": "^7.3.0"
  },
  "bundledDependencies": [
    "@aliou/pi-processes"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  }
}
